# Server
PORT=3000
BASE_URL=http://localhost:3000
TRUST_PROXY=0

# Admin console password, sent as the x-admin-token header. Change this.
ADMIN_TOKEN=change-me-please

# SQLite file. Use :memory: for a throwaway database.
DB_PATH=./data/reviewqr.db

# How many reviews the public profile shows (3-6).
MAX_VISIBLE_REVIEWS=6

# The Blue Door Cafe demo business, seeded on startup so a fresh install has
# something to scan. Defaults to on in development and off in production.
# Set to 1 or 0 to decide for yourself.
SEED_DEMO=

# Email delivery for the 6-digit login codes.
# Leave SMTP_HOST empty in development and codes are printed to the server console.
# In production (NODE_ENV=production) SMTP_HOST, SMTP_PORT and MAIL_FROM are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ReviewQR <no-reply@example.com>"

# AI drafts. Without a key the app falls back to template drafts.
# claude-haiku-5-5 is cheaper and faster, and fine for this workload.
# A key makes drafts possible; each business then switches them on or off for
# itself in the admin console, so one venue can use the model and another not.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google One Tap sign-in. Empty means customers review with nothing asked of
# them. A Web application OAuth client id from console.cloud.google.com, whose
# Authorized JavaScript origins must list your BASE_URL exactly (https only,
# apart from http://localhost). Also switchable per business in the admin
# console, the same as AI drafts.
GOOGLE_CLIENT_ID=
